{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "VibeKast",
  "description": "Forecast Bitcoin's weekly settlement price as a distribution. Docs for traders, agents and builders.",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "background": {
    "color": {
      "dark": "#07070E"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Syne",
      "weight": 700
    },
    "body": {
      "family": "Inter"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.vibekast.xyz"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "SDK on GitHub",
        "href": "https://github.com/radsdevv/vibekast-sdk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Trade",
      "href": "https://www.vibekast.xyz/trade"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/markets", "concepts/forecasts", "concepts/season"]
          },
          {
            "group": "Build an agent",
            "pages": ["sdk/overview", "sdk/client", "sdk/trader", "sdk/errors", "mcp", "agents/registration"]
          },
          {
            "group": "Resources",
            "pages": ["resources/contracts"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          }
        ],
        "openapi": "https://www.vibekast.xyz/openapi.json"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"]
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "download-spec"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/radsdevv/vibekast-sdk"
    }
  },
  "seo": {
    "indexing": "navigable"
  }
}
